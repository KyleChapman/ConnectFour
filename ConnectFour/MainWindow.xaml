<Window x:Class="ConnectFour.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConnectFour"
        mc:Ignorable="d"
        Title="Connect Four"
        WindowStartupLocation="CenterScreen"    
        MinHeight="600" Height="600"
        MinWidth="600" Width="800" FontSize="13">
    <Grid x:Name="gridBoard">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition MinWidth="20"/>
            <ColumnDefinition MinWidth="50"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Button x:Name="buttonColumn0" Grid.Row="0" Grid.Column="0" Content="Drop Here" Height="30" Click="DropInColumnClick" />
        <Button x:Name="buttonColumn1" Grid.Row="0" Grid.Column="1" Content="Drop Here" Height="30" Click="DropInColumnClick" />
        <Button x:Name="buttonColumn2" Grid.Row="0" Grid.Column="2" Content="Drop Here" Height="30" Click="DropInColumnClick" />
        <Button x:Name="buttonColumn3" Grid.Row="0" Grid.Column="3" Content="Drop Here" Height="30" Click="DropInColumnClick" />
        <Button x:Name="buttonColumn4" Grid.Row="0" Grid.Column="4" Content="Drop Here" Height="30" Click="DropInColumnClick" />
        <Button x:Name="buttonColumn5" Grid.Row="0" Grid.Column="5" Content="Drop Here" Height="30" Click="DropInColumnClick" />
        <Button x:Name="buttonColumn6" Grid.Row="0" Grid.Column="6" Content="Drop Here" Height="30" Click="DropInColumnClick" />

        <Label x:Name="labelRow0Column0" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="0"/>
        <Label x:Name="labelRow0Column1" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="1"/>
        <Label x:Name="labelRow0Column2" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="2"/>
        <Label x:Name="labelRow0Column3" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="3"/>
        <Label x:Name="labelRow0Column4" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="4"/>
        <Label x:Name="labelRow0Column5" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="5"/>
        <Label x:Name="labelRow0Column6" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="6"/>
        <Label x:Name="labelRow1Column0" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="0"/>
        <Label x:Name="labelRow1Column1" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="1"/>
        <Label x:Name="labelRow1Column2" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="2"/>
        <Label x:Name="labelRow1Column3" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="3"/>
        <Label x:Name="labelRow1Column4" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="4"/>
        <Label x:Name="labelRow1Column5" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="5"/>
        <Label x:Name="labelRow1Column6" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="6"/>
        <Label x:Name="labelRow2Column0" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="3" Grid.Column="0"/>
        <Label x:Name="labelRow2Column1" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="3" Grid.Column="1"/>
        <Label x:Name="labelRow2Column2" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="3" Grid.Column="2"/>
        <Label x:Name="labelRow2Column3" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="3" Grid.Column="3"/>
        <Label x:Name="labelRow2Column4" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="3" Grid.Column="4"/>
        <Label x:Name="labelRow2Column5" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="3" Grid.Column="5"/>
        <Label x:Name="labelRow2Column6" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="3" Grid.Column="6"/>
        <Label x:Name="labelRow3Column0" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="4" Grid.Column="0"/>
        <Label x:Name="labelRow3Column1" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="4" Grid.Column="1"/>
        <Label x:Name="labelRow3Column2" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="4" Grid.Column="2"/>
        <Label x:Name="labelRow3Column3" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="4" Grid.Column="3"/>
        <Label x:Name="labelRow3Column4" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="4" Grid.Column="4"/>
        <Label x:Name="labelRow3Column5" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="4" Grid.Column="5"/>
        <Label x:Name="labelRow3Column6" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="4" Grid.Column="6"/>
        <Label x:Name="labelRow4Column0" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="5" Grid.Column="0"/>
        <Label x:Name="labelRow4Column1" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="5" Grid.Column="1"/>
        <Label x:Name="labelRow4Column2" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="5" Grid.Column="2"/>
        <Label x:Name="labelRow4Column3" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="5" Grid.Column="3"/>
        <Label x:Name="labelRow4Column4" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="5" Grid.Column="4"/>
        <Label x:Name="labelRow4Column5" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="5" Grid.Column="5"/>
        <Label x:Name="labelRow4Column6" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="5" Grid.Column="6"/>
        <Label x:Name="labelRow5Column0" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="6" Grid.Column="0"/>
        <Label x:Name="labelRow5Column1" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="6" Grid.Column="1"/>
        <Label x:Name="labelRow5Column2" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="6" Grid.Column="2"/>
        <Label x:Name="labelRow5Column3" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="6" Grid.Column="3"/>
        <Label x:Name="labelRow5Column4" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="6" Grid.Column="4"/>
        <Label x:Name="labelRow5Column5" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="6" Grid.Column="5"/>
        <Label x:Name="labelRow5Column6" Content="●"  FontSize="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="6" Grid.Column="6"/>

        <Label Grid.Column="7" Content="_Current Player:" HorizontalAlignment="Right" Grid.Row="1" VerticalAlignment="Center" Margin="3"/>
        <TextBox x:Name="textCurrentPlayer" Grid.Column="8" HorizontalAlignment="Left" Margin="3" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="60" IsReadOnly="True"/>

        <Label Grid.Column="7" Content="_Red Points:" HorizontalAlignment="Right" Grid.Row="2" VerticalAlignment="Center" Margin="3"/>
        <TextBox x:Name="textRedPoints" Grid.Column="8" HorizontalAlignment="Left" Margin="3" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Center" Width="60" IsReadOnly="True"/>

        <Label Grid.Column="7" Content="_Yellow Points" HorizontalAlignment="Right" Grid.Row="3" VerticalAlignment="Center" Margin="3"/>
        <TextBox x:Name="textYellowPoints" Grid.Column="8" HorizontalAlignment="Left" Margin="3,3,3,3" Grid.Row="3" TextWrapping="Wrap" VerticalAlignment="Center" Width="60" IsReadOnly="True"/>

        <Label Grid.Column="7" Content="_Ties:" HorizontalAlignment="Right" Grid.Row="4" VerticalAlignment="Center" Margin="3"/>
        <TextBox x:Name="textTies" Grid.Column="8" HorizontalAlignment="Left" Margin="3" Grid.Row="4" TextWrapping="Wrap" VerticalAlignment="Center" Width="60" IsReadOnly="True"/>

        <Button Grid.Column="7" Content="Reset _Game" Margin="10" Grid.Row="5" Grid.ColumnSpan="2" Width="95" />
        <Button Grid.Column="7" Content="Reset _Scores" Margin="10" Grid.Row="6" Grid.ColumnSpan="2" Width="95" Click="ResetScores" />

    </Grid>

</Window>
